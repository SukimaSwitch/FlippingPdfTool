{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flippingpdftool.local/contracts/worker-result.schema.json",
  "title": "Automated PDF Worker Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "status",
    "sitePrefix",
    "artifactPrefix"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "processed",
        "failed"
      ]
    },
    "workerRunId": {
      "type": "string",
      "minLength": 1
    },
    "sitePrefix": {
      "type": "string",
      "enum": [
        "currentcatalog",
        "colorfulimages",
        "lillianvernon"
      ]
    },
    "outputBucket": {
      "type": "string",
      "const": "cmg-catalog-book"
    },
    "outputKey": {
      "type": "string",
      "pattern": "^output\/(currentcatalog|colorfulimages|lillianvernon)\/.*\\.pdf$"
    },
    "artifactPrefix": {
      "type": "string",
      "pattern": "^artifacts\/.*"
    },
    "failureStage": {
      "type": "string",
      "enum": [
        "download",
        "processing",
        "upload"
      ]
    },
    "failureCode": {
      "type": "string"
    },
    "failureMessage": {
      "type": "string"
    },
    "pageCount": {
      "type": "integer",
      "minimum": 0
    },
    "matchedSkuCount": {
      "type": "integer",
      "minimum": 0
    },
    "unmatchedSkuCount": {
      "type": "integer",
      "minimum": 0
    },
    "unresolvedMatchCount": {
      "type": "integer",
      "minimum": 0
    },
    "linkCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "processed"
          }
        }
      },
      "then": {
        "required": [
          "workerRunId",
          "outputBucket",
          "outputKey",
          "pageCount",
          "matchedSkuCount",
          "unmatchedSkuCount",
          "unresolvedMatchCount",
          "linkCount"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "failureStage",
          "failureMessage"
        ]
      }
    }
  ]
}
